/** app.wxss - 全局认知沉浸式主题 **/
page {
  background-color: #090d16;
  color: #f1f5f9;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view, input, textarea {
  box-sizing: border-box;
}

/* 认知语义色彩变量 */
.color-obs { color: #38bdf8; }
.bg-obs-subtle { background-color: rgba(56, 189, 248, 0.12); border-color: rgba(56, 189, 248, 0.35); }

.color-que { color: #c084fc; }
.bg-que-subtle { background-color: rgba(192, 132, 252, 0.12); border-color: rgba(192, 132, 252, 0.35); }

.color-hyp { color: #facc15; }
.bg-hyp-subtle { background-color: rgba(250, 204, 21, 0.12); border-color: rgba(250, 204, 21, 0.35); }

.color-evi { color: #34d399; }
.bg-evi-subtle { background-color: rgba(52, 211, 153, 0.12); border-color: rgba(52, 211, 153, 0.35); }

.color-bot { color: #fb7185; }
.bg-bot-subtle { background-color: rgba(251, 113, 133, 0.12); border-color: rgba(251, 113, 133, 0.35); }

/* 通用容器卡片 */
.glass-card {
  background: rgba(30, 41, 59, 0.7);
  backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
}

/* 按钮点击态 */
.tap-active {
  opacity: 0.75;
  transform: scale(0.98);
  transition: all 0.15s ease;
}

/* 阴影效果 */
.shadow-sm {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.25);
}

.shadow-glow-cyan {
  box-shadow: 0 0 20rpx rgba(56, 189, 248, 0.25);
}

.shadow-glow-purple {
  box-shadow: 0 0 20rpx rgba(192, 132, 252, 0.25);
}
