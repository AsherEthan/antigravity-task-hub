/* components/stream-item/stream-item.wxss */
.item-card {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  background: rgba(30, 41, 59, 0.7);
  border-radius: 20rpx;
  border-left: 6rpx solid #64748b;
  transition: all 0.2s ease;
}

.border-observation { border-left-color: #38bdf8; }
.border-question { border-left-color: #c084fc; }
.border-hypothesis { border-left-color: #facc15; }
.border-evidence { border-left-color: #34d399; }
.border-bottleneck { border-left-color: #fb7185; }

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  border: 1rpx solid transparent;
}

.badge-observation { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border-color: rgba(56, 189, 248, 0.3); }
.badge-question { background: rgba(192, 132, 252, 0.15); color: #c084fc; border-color: rgba(192, 132, 252, 0.3); }
.badge-hypothesis { background: rgba(250, 204, 21, 0.15); color: #facc15; border-color: rgba(250, 204, 21, 0.3); }
.badge-evidence { background: rgba(52, 211, 153, 0.15); color: #34d399; border-color: rgba(52, 211, 153, 0.3); }
.badge-bottleneck { background: rgba(251, 113, 133, 0.15); color: #fb7185; border-color: rgba(251, 113, 133, 0.3); }

.header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.time-text {
  font-size: 22rpx;
  color: #64748b;
}

.delete-btn {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
}

.del-icon {
  font-size: 28rpx;
  color: #94a3b8;
  line-height: 1;
}

.item-content {
  font-size: 28rpx;
  color: #f1f5f9;
  line-height: 1.6;
  word-break: break-word;
}

.lineage-tag {
  margin-top: 12rpx;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: #94a3b8;
  background: rgba(255, 255, 255, 0.04);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

/* 透镜工具栏 */
.lens-toolbar {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.lens-title {
  display: flex;
  align-items: center;
}

.lens-label {
  font-size: 22rpx;
  color: #64748b;
  margin-right: 4rpx;
}

.lens-pills {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.lens-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  background: rgba(15, 23, 42, 0.7);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #cbd5e1;
  transition: all 0.15s ease;
}

.lens-btn:active {
  background: rgba(56, 189, 248, 0.2);
  border-color: rgba(56, 189, 248, 0.4);
  color: #38bdf8;
}

.btn-icon {
  font-size: 20rpx;
}

/* 挂载见解区 (Mount & Spin-off) */
.insights-container {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.insight-box {
  background: rgba(15, 23, 42, 0.85);
  border: 1rpx solid rgba(192, 132, 252, 0.25);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}

.insight-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.insight-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.spark-icon {
  font-size: 22rpx;
}

.insight-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #c084fc;
}

.insight-time {
  font-size: 20rpx;
  color: #64748b;
}

.insight-summary {
  font-size: 25rpx;
  color: #cbd5e1;
  line-height: 1.5;
}

/* 衍生子项列表 */
.spinoff-list {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.spinoff-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.03);
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
}

.subitem-left {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  flex: 1;
}

.subitem-dot {
  color: #38bdf8;
  font-weight: bold;
}

.subitem-text {
  font-size: 24rpx;
  color: #e2e8f0;
  line-height: 1.4;
}

.btn-spinoff {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  background: rgba(56, 189, 248, 0.15);
  border: 1rpx solid rgba(56, 189, 248, 0.35);
  color: #38bdf8;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.spinoff-plus {
  font-size: 20rpx;
  font-weight: bold;
}
