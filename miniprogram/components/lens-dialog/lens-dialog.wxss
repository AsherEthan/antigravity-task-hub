/* components/lens-dialog/lens-dialog.wxss */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(8px);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.dialog-container {
  width: 100%;
  max-width: 680rpx;
  max-height: 85vh;
  background: #0f172a;
  border: 1rpx solid rgba(56, 189, 248, 0.3);
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.6);
}

.dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.header-tag {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tag-icon {
  font-size: 28rpx;
}

.dialog-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #f8fafc;
}

.close-btn {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.close-icon {
  font-size: 32rpx;
  color: #94a3b8;
  line-height: 1;
}

.dialog-scroll-body {
  padding: 28rpx;
  max-height: 60vh;
}

/* 加载中 */
.loading-state {
  padding: 60rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.spin-icon {
  font-size: 48rpx;
  animation: rotate 2s linear infinite;
}

@keyframes rotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-tip {
  font-size: 28rpx;
  font-weight: 600;
  color: #38bdf8;
}

.sub-tip {
  font-size: 22rpx;
  color: #64748b;
}

/* 锐评横幅 */
.critique-banner {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: rgba(250, 204, 21, 0.1);
  border: 1rpx solid rgba(250, 204, 21, 0.3);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

.critique-icon {
  font-size: 28rpx;
}

.critique-text {
  font-size: 24rpx;
  color: #fde047;
  line-height: 1.5;
}

/* 建议字段 */
.proposal-field {
  margin-bottom: 20rpx;
}

.field-label {
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  display: block;
}

.field-input {
  width: 100%;
  background: rgba(30, 41, 59, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  font-size: 26rpx;
  color: #f1f5f9;
  line-height: 1.5;
}

.unknowns-preview {
  background: rgba(30, 41, 59, 0.8);
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.u-item {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  font-size: 24rpx;
  color: #e2e8f0;
}

.u-bullet {
  color: #c084fc;
}

/* 透镜分析结果 */
.lens-summary-box {
  background: rgba(30, 41, 59, 0.8);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.summary-text {
  font-size: 27rpx;
  color: #f8fafc;
  line-height: 1.6;
}

.lens-items-box {
  background: rgba(15, 23, 42, 0.6);
  border-radius: 16rpx;
  padding: 20rpx;
}

.box-title {
  font-size: 23rpx;
  font-weight: 600;
  color: #94a3b8;
  margin-bottom: 12rpx;
  display: block;
}

.l-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.l-dot {
  color: #38bdf8;
  font-weight: bold;
}

.l-text {
  font-size: 25rpx;
  color: #cbd5e1;
  line-height: 1.5;
}

/* 底部操作 */
.dialog-footer {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.btn-cancel {
  margin: 0;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #94a3b8;
  font-size: 26rpx;
  border-radius: 16rpx;
  border: none;
}

.btn-confirm {
  margin: 0;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 4rpx 14rpx rgba(56, 189, 248, 0.35);
}
