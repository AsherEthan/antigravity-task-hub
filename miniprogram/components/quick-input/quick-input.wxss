/* components/quick-input/quick-input.wxss */
.quick-input-container {
  padding: 12rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(9, 13, 22, 0.8) 0%, rgba(9, 13, 22, 0.98) 100%);
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20px);
}

.type-selector-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.type-pills-row {
  display: flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.type-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 22rpx;
  background: rgba(30, 41, 59, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 28rpx;
  transition: all 0.2s ease;
}

.pill-icon {
  font-size: 24rpx;
}

.pill-text {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 500;
}

/* 胶囊激活状态色彩 */
.pill-active-observation {
  background: rgba(56, 189, 248, 0.2);
  border-color: #38bdf8;
  box-shadow: 0 0 16rpx rgba(56, 189, 248, 0.3);
}
.pill-active-observation .pill-text { color: #38bdf8; font-weight: 700; }

.pill-active-question {
  background: rgba(192, 132, 252, 0.2);
  border-color: #c084fc;
  box-shadow: 0 0 16rpx rgba(192, 132, 252, 0.3);
}
.pill-active-question .pill-text { color: #c084fc; font-weight: 700; }

.pill-active-hypothesis {
  background: rgba(250, 204, 21, 0.2);
  border-color: #facc15;
  box-shadow: 0 0 16rpx rgba(250, 204, 21, 0.3);
}
.pill-active-hypothesis .pill-text { color: #facc15; font-weight: 700; }

.pill-active-evidence {
  background: rgba(52, 211, 153, 0.2);
  border-color: #34d399;
  box-shadow: 0 0 16rpx rgba(52, 211, 153, 0.3);
}
.pill-active-evidence .pill-text { color: #34d399; font-weight: 700; }

.pill-active-bottleneck {
  background: rgba(251, 113, 133, 0.2);
  border-color: #fb7185;
  box-shadow: 0 0 16rpx rgba(251, 113, 133, 0.3);
}
.pill-active-bottleneck .pill-text { color: #fb7185; font-weight: 700; }

/* 输入栏 */
.input-action-bar {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 12rpx 16rpx;
  background: rgba(15, 23, 42, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
}

.input-field {
  flex: 1;
  min-height: 48rpx;
  max-height: 160rpx;
  font-size: 28rpx;
  color: #f8fafc;
  line-height: 1.4;
  padding: 6rpx 8rpx;
}

.input-placeholder {
  color: #64748b;
  font-size: 26rpx;
}

.btn-submit {
  flex-shrink: 0;
  margin: 0;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: #334155;
  border-radius: 20rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.btn-submit-active {
  background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%);
  box-shadow: 0 4rpx 16rpx rgba(56, 189, 248, 0.4);
}

.submit-text {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 600;
}
