/* pages/index/index.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #090d16;
  overflow: hidden;
}

/* 顶部导航与项目切换器 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 24rpx;
  background: rgba(15, 23, 42, 0.85);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  flex-shrink: 0;
  z-index: 50;
}

.project-selector {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  overflow: hidden;
}

.project-icon-box {
  width: 56rpx;
  height: 56rpx;
  background: rgba(56, 189, 248, 0.15);
  border: 1rpx solid rgba(56, 189, 248, 0.3);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.project-icon {
  font-size: 28rpx;
}

.project-info {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.project-label {
  font-size: 20rpx;
  color: #64748b;
  letter-spacing: 0.5rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.project-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #f8fafc;
  max-width: 460rpx;
}

.switch-arrow {
  font-size: 24rpx;
  color: #94a3b8;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.action-btn {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon {
  font-size: 28rpx;
}

/* 主滚动区域 */
.main-scroll {
  flex: 1;
  height: 100%;
}

/* 流水头部与过滤器 */
.stream-header {
  padding: 12rpx 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.stream-header-left {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.stream-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #e2e8f0;
}

.stream-count {
  font-size: 22rpx;
  color: #64748b;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-row {
  display: flex;
  gap: 10rpx;
  padding: 4rpx 0;
}

.filter-chip {
  padding: 6rpx 18rpx;
  background: rgba(30, 41, 59, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #94a3b8;
  flex-shrink: 0;
  transition: all 0.15s ease;
}

.chip-active { background: rgba(255, 255, 255, 0.15); color: #ffffff; border-color: rgba(255, 255, 255, 0.3); font-weight: 600; }
.chip-active-obs { background: rgba(56, 189, 248, 0.2); color: #38bdf8; border-color: #38bdf8; font-weight: 600; }
.chip-active-que { background: rgba(192, 132, 252, 0.2); color: #c084fc; border-color: #c084fc; font-weight: 600; }
.chip-active-hyp { background: rgba(250, 204, 21, 0.2); color: #facc15; border-color: #facc15; font-weight: 600; }
.chip-active-evi { background: rgba(52, 211, 153, 0.2); color: #34d399; border-color: #34d399; font-weight: 600; }
.chip-active-bot { background: rgba(251, 113, 133, 0.2); color: #fb7185; border-color: #fb7185; font-weight: 600; }

/* 流水列表 */
.stream-list {
  padding-top: 8rpx;
}

/* 空白态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
  gap: 12rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 8rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #cbd5e1;
}

.empty-desc {
  font-size: 24rpx;
  color: #64748b;
  max-width: 480rpx;
  line-height: 1.4;
}

.bottom-placeholder {
  height: 220rpx;
}

/* 底部固定录入条 */
.fixed-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
}
