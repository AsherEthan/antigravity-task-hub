/* pages/settings/settings.wxss */
.settings-container {
  padding: 24rpx;
  background-color: #090d16;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.status-card {
  padding: 24rpx;
  background: rgba(30, 41, 59, 0.7);
  border-radius: 20rpx;
}

.card-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #f8fafc;
}

.status-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.pill-green {
  background: rgba(52, 211, 153, 0.15);
  color: #34d399;
  border: 1rpx solid rgba(52, 211, 153, 0.35);
}
.pill-green .pill-dot { background-color: #34d399; }

.pill-amber {
  background: rgba(250, 204, 21, 0.15);
  color: #facc15;
  border: 1rpx solid rgba(250, 204, 21, 0.35);
}
.pill-amber .pill-dot { background-color: #facc15; }

.pill-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.status-tip {
  font-size: 23rpx;
  color: #94a3b8;
  line-height: 1.5;
}

/* 区域卡片 */
.section-card {
  padding: 24rpx;
  background: rgba(30, 41, 59, 0.7);
  border-radius: 20rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #e2e8f0;
  display: block;
}

.sub-title {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 4rpx;
  display: block;
}

.form-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-label {
  font-size: 24rpx;
  color: #cbd5e1;
  font-weight: 500;
}

.toggle-eye {
  font-size: 22rpx;
  color: #38bdf8;
  padding: 2rpx 8rpx;
}

.item-input {
  background: rgba(15, 23, 42, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  font-size: 26rpx;
  color: #f8fafc;
}

.input-hint {
  font-size: 20rpx;
  color: #64748b;
}

.btn-save {
  margin: 0;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 18rpx;
  border: none;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-action-outline {
  margin: 0;
  height: 72rpx;
  line-height: 72rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: #cbd5e1;
  font-size: 25rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.btn-action-danger {
  margin: 0;
  height: 72rpx;
  line-height: 72rpx;
  background: rgba(251, 113, 133, 0.1);
  border: 1rpx solid rgba(251, 113, 133, 0.25);
  color: #fb7185;
  font-size: 25rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.btn-icon {
  font-size: 26rpx;
}

/* 哲学标语区 */
.philosophy-box {
  margin-top: 12rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: rgba(15, 23, 42, 0.5);
  border: 1rpx dashed rgba(255, 255, 255, 0.1);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: center;
  text-align: center;
}

.ph-title {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 600;
}

.ph-formula {
  font-size: 24rpx;
  color: #38bdf8;
  font-family: monospace;
  font-weight: 700;
}

.ph-rule {
  font-size: 22rpx;
  color: #e2e8f0;
  font-weight: 500;
}

.ph-motto {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #94a3b8;
  font-style: italic;
}
